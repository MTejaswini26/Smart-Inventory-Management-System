# ---------------------------------------------------------------------------
# Password reset email (SMTP). Fill these in and restart Flask to enable
# "Forgot Password" emails. Leave SMTP_HOST empty to disable email sending.
#
# Example for a Gmail account (use a 16-character App Password, NOT your
# normal Gmail password; enable 2-Step Verification first):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURITY=true
#   SMTP_USERNAME=yourgmailaddress@gmail.com
#   SMTP_PASSWORD=your16charapppassword
#   SMTP_FROM=yourgmailaddress@gmail.com
#
# Example for Outlook/Office365: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Example for Yahoo:             SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true = STARTTLS (port 587), ssl = implicit TLS (port 465), false = plain
SMTP_SECURITY=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Base URL of the React frontend, used to build the reset link inside the email.
APP_URL=http://localhost:5173

# Optional: email bound to the "admin" account at startup when it has none yet,
# so the password reset email has a destination.
ADMIN_EMAIL=