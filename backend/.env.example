# Copy to backend/.env and fill in real values. Never commit backend/.env.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=smart_inventory
DB_PORT=3306
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24
REMEMBER_ME_DAYS=30
RESET_TOKEN_MINUTES=15
# Leave SMTP_HOST empty to disable password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# No-Node runtime: Flask serves the built UI on :5001.
APP_URL=http://localhost:5001
ADMIN_EMAIL=
